@model IEnumerable<GymManagementSystem.Models.Entities.Trainer>
@{
    ViewData["Title"] = "Antrenörler";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Antrenörler</h2>
        <a asp-action="CreateTrainer" class="btn btn-primary">+ Yeni Antrenör Ekle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Uzmanlık</th>
                    <th>Email</th>
                    <th>Saatlik Ücret</th>
                    <th>Durum</th>
                    <th style="width: 210px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trainer in Model)
                {
                    var fullName = trainer.User != null
                        ? $"{trainer.User.FirstName} {trainer.User.LastName}"
                        : $"{trainer.FirstName} {trainer.LastName}";
                    <tr>
                        <td>@fullName</td>
                        <td>@trainer.Specialization</td>
                        <td>@(trainer.User?.Email ?? trainer.Email)</td>
                        <td>@trainer.HourlyRate.ToString("C")</td>
                        <td>
                            @if (trainer.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="TrainerDetails" asp-route-id="@trainer.TrainerId" class="btn btn-outline-secondary">Detay</a>
                                <a asp-action="EditTrainer" asp-route-id="@trainer.TrainerId" class="btn btn-outline-primary">Düzenle</a>
                                <form asp-action="DeleteTrainer" asp-route-id="@trainer.TrainerId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Antrenörü silmek istediğinize emin misiniz?');">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
