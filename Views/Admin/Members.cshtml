@model GymManagementSystem.Models.ViewModels.MemberListViewModel
@{
    ViewData["Title"] = "Üye Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Üyeler</h2>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ad, soyad veya email">
            <button type="submit" class="btn btn-primary">Ara</button>
        </form>
    </div>

    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Üyelik Planı</th>
                    <th>Kayıt Tarihi</th>
                    <th>Durum</th>
                    <th style="width: 220px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Members)
                {
                    var fullName = member.User != null
                        ? $"{member.User.FirstName} {member.User.LastName}"
                        : $"{member.FirstName} {member.LastName}";
                    var email = member.User?.Email ?? member.Email;
                    <tr>
                        <td>@fullName</td>
                        <td>@email</td>
                        <td>@(member.MembershipPlan?.Name ?? "Plan Yok")</td>
                        <td>@member.RegisteredAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (member.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="MemberDetails" asp-route-id="@member.MemberId" class="btn btn-outline-primary">Detaylar</a>
                                <a asp-action="MemberDetails" asp-route-id="@member.MemberId" class="btn btn-outline-secondary">Üyelik Planı Değiştir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
