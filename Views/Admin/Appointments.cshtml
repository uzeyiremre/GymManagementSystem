@model GymManagementSystem.Models.ViewModels.AppointmentListViewModel
@{
    ViewData["Title"] = "Randevular";
    string statusValue = Model.Status ?? "All";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Randevular</h2>
        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">+ Yeni Randevu Oluştur</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="card card-body shadow-sm border-0 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Durum</label>
                @{
                    var statusOptions = new List<(string Value, string Text)>
                    {
                        ("All", "Tümü"),
                        ("Pending", "Beklemede"),
                        ("Scheduled", "Planlandı"),
                        ("Completed", "Tamamlandı"),
                        ("Cancelled", "İptal")
                    };
                    var currentStatus = string.IsNullOrWhiteSpace(statusValue) ? "All" : statusValue;
                }
                <select class="form-select" name="status">
                    @foreach (var option in statusOptions)
                    {
                        var selectedSegment = string.Equals(currentStatus, option.Value, StringComparison.OrdinalIgnoreCase)
                            ? " selected"
                            : string.Empty;
                        var optionHtml = $"<option value=\"{option.Value}\"{selectedSegment}>{option.Text}</option>";
                        @Html.Raw(optionHtml)
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="date" class="form-control" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="date" class="form-control" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Üye / Antrenör</label>
                <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" placeholder="İsim ile ara" />
            </div>
            <div class="col-12 text-end mt-2">
                <button type="submit" class="btn btn-outline-primary">Filtrele</button>
            </div>
        </div>
    </form>

    <div class="table-responsive shadow-sm border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Üye</th>
                    <th>Antrenör</th>
                    <th>Servis</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Fiyat</th>
                    <th style="width: 260px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    var memberName = appointment.Member?.User != null
                        ? $"{appointment.Member.User.FirstName} {appointment.Member.User.LastName}"
                        : appointment.Member != null ? $"{appointment.Member.FirstName} {appointment.Member.LastName}" : "-";
                    var trainerName = appointment.Trainer?.User != null
                        ? $"{appointment.Trainer.User.FirstName} {appointment.Trainer.User.LastName}"
                        : appointment.Trainer != null ? $"{appointment.Trainer.FirstName} {appointment.Trainer.LastName}" : "-";
                    <tr>
                        <td>@memberName</td>
                        <td>@trainerName</td>
                        <td>@(appointment.Service?.Name ?? "-")</td>
                        <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @switch (appointment.Status)
                            {
                                case "Scheduled":
                                    <span class="badge bg-info">Planlandı</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-success">Tamamlandı</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">İptal</span>
                                    break;
                                case "Pending":
                                    <span class="badge bg-warning text-dark">Beklemede</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@appointment.Status</span>
                                    break;
                            }
                        </td>
                        <td>@appointment.TotalPrice.ToString("C")</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <form asp-action="ApproveAppointment" asp-route-id="@appointment.AppointmentId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success" @(appointment.Status == "Scheduled" ? "disabled" : null)>Onayla</button>
                                </form>
                                <form asp-action="RejectAppointment" asp-route-id="@appointment.AppointmentId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" @(appointment.Status == "Cancelled" ? "disabled" : null)>Reddet</button>
                                </form>
                                <form asp-action="CompleteAppointment" asp-route-id="@appointment.AppointmentId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-primary" @(appointment.Status == "Completed" ? "disabled" : null)>Tamamla</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
