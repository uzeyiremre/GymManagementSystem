@using System.Text.Json
@model GymManagementSystem.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
    var appointmentSeries = Model.RecentAppointments
        .GroupBy(a => new { a.AppointmentDate.Year, a.AppointmentDate.Month })
        .Select(g => new { g.Key.Year, g.Key.Month, Count = g.Count() })
        .OrderBy(g => g.Year).ThenBy(g => g.Month)
        .ToList();
}

<div class="container py-4">
    <div class="rounded-4 gradient-blue text-white p-4 mb-4 shadow-soft">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <p class="mb-1 text-uppercase fw-bold">Kontrol Merkezi</p>
                <h2 class="mb-0 fw-bold">Admin Dashboard</h2>
                <p class="mb-0">Sistemin durumunu takip edin, verileri analiz edin.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Admin" asp-action="Reports" class="btn btn-outline-light">Raporlara Git</a>
                <a asp-controller="Admin" asp-action="Appointments" class="btn btn-primary text-dark">Randevular</a>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-kpi kpi-orange h-100">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Üyeler</p>
                    <h3 class="fw-bold mb-0">@Model.TotalMembers</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-kpi kpi-blue h-100">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Antrenörler</p>
                    <h3 class="fw-bold mb-0">@Model.TotalTrainers</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-kpi kpi-yellow h-100">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Bekleyen Randevular</p>
                    <h3 class="fw-bold mb-0">@Model.PendingAppointments</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card card-kpi kpi-green h-100">
                <div class="card-body">
                    <p class="text-muted text-uppercase small mb-1">Aylık Gelir</p>
                    <h3 class="fw-bold mb-0">@Model.MonthlyRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Son Üyeler</h5>
                    <a asp-action="Members" class="btn btn-sm btn-outline-secondary">Tümü</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>Email</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.RecentMembers)
                                {
                                    <tr>
                                        <td>@(member.User != null ? $"{member.User.FirstName} {member.User.LastName}" : $"{member.FirstName} {member.LastName}")</td>
                                        <td>@(member.User?.Email ?? member.Email)</td>
                                        <td>@member.RegisteredAt.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Son Randevular</h5>
                    <a asp-action="Appointments" class="btn btn-sm btn-outline-secondary">Tümü</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Üye</th>
                                    <th>Antrenör</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td>@(appointment.Member?.User != null ? $"{appointment.Member.User.FirstName} {appointment.Member.User.LastName}" : appointment.Member != null ? $"{appointment.Member.FirstName} {appointment.Member.LastName}" : "-")</td>
                                        <td>@(appointment.Trainer?.User != null ? $"{appointment.Trainer.User.FirstName} {appointment.Trainer.User.LastName}" : appointment.Trainer != null ? $"{appointment.Trainer.FirstName} {appointment.Trainer.LastName}" : "-")</td>
                                        <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge bg-primary">@appointment.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Aylık Randevu Grafiği</h5>
        </div>
        <div class="card-body">
            <canvas id="appointmentsChart" height="130"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('appointmentsChart');
        const chartLabels = @Html.Raw(JsonSerializer.Serialize(appointmentSeries.Select(a => $"{a.Month:D2}.{a.Year}")));
        const chartData = @Html.Raw(JsonSerializer.Serialize(appointmentSeries.Select(a => a.Count)));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Randevu Sayısı',
                    data: chartData,
                    borderColor: '#FF6B35',
                    backgroundColor: 'rgba(255,107,53,0.15)',
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
