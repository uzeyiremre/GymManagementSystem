@model GymManagementSystem.Models.ViewModels.MemberProfileViewModel
@{
    ViewData["Title"] = "Profilim";
    var profileImage = string.IsNullOrWhiteSpace(Model.ProfileImageUrl)
        ? Url.Content("~/img/profile-placeholder.svg")
        : Model.ProfileImageUrl;
    var totalAppointments = Model.TotalAppointments;
    var completed = Model.CompletedAppointments;
    var completionRate = totalAppointments > 0 ? (int)Math.Round((double)completed / totalAppointments * 100) : 0;
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100 gradient-blue text-white">
                <div class="card-body text-center">
                    <img src="@profileImage" alt="Profil" class="rounded-circle mb-3 border border-3 border-light" width="120" height="120" />
                    <h4 class="fw-bold">@Model.FirstName @Model.LastName</h4>
                    <p class="mb-1">@Model.Email</p>
                    <span class="badge badge-pill badge-primary text-dark fw-semibold">@Model.MembershipPlanName</span>
                    <div class="d-flex justify-content-between mt-4">
                        <div>
                            <p class="text-white-50 small mb-0">Toplam Randevu</p>
                            <h5 class="fw-bold">@totalAppointments</h5>
                        </div>
                        <div>
                            <p class="text-white-50 small mb-0">Tamamlanan</p>
                            <h5 class="fw-bold">@completed</h5>
                        </div>
                    </div>
                    <div class="mt-3 text-start">
                        <p class="text-white-50 small mb-1">İlerleme</p>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @completionRate%" aria-valuenow="@completionRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="d-block mt-1">@completionRate% tamamlandı</small>
                        <p class="text-white-50 small mt-3">Üyelik Başlangıcı: @Model.RegisteredAt.ToString("dd.MM.yyyy")</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Profil Bilgileri</h5>
                </div>
                <form asp-action="UpdateProfile" method="post" class="card-body row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label">Ad</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Soyad</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telefon</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                    </div>
                </form>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Şifre Değiştir</h5>
                </div>
                <form asp-action="ChangePassword" method="post" class="card-body row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label">Mevcut Şifre</label>
                        <input type="password" name="currentPassword" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Yeni Şifre</label>
                        <input type="password" name="newPassword" class="form-control" required />
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-primary">Şifreyi Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
