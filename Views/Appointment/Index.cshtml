@model IEnumerable<GymManagementSystem.Models.Entities.Appointment>
@{
    ViewData["Title"] = "&#128197; Randevularım";
    var hasAppointments = Model?.Any() ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">&#128197; Randevularım</h2>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Randevu Oluştur</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!hasAppointments)
    {
        <div class="alert alert-info">
            <strong>Henüz randevunuz bulunmamaktadır.</strong>
            <div>
                <a asp-action="Create" class="alert-link">Yeni randevu oluşturmak için tıklayın.</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Antrenör</th>
                        <th scope="col">Tarih</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Notlar</th>
                        <th scope="col">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model ?? Array.Empty<GymManagementSystem.Models.Entities.Appointment>())
                    {
                        <tr>
                            <td>
                                <strong>
                                    @(appointment.Trainer?.User != null
                                        ? $"{appointment.Trainer.User.FirstName} {appointment.Trainer.User.LastName}"
                                        : appointment.Trainer != null
                                            ? $"{appointment.Trainer.FirstName} {appointment.Trainer.LastName}"
                                            : "Bilinmiyor")
                                </strong>
                                <br />
                                <small class="text-muted">@appointment.Trainer?.Specialization</small>
                            </td>
                            <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (appointment.Status)
                                {
                                    case "Scheduled":
                                        <span class="badge bg-info">Planlandı</span>;
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">Tamamlandı</span>;
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">İptal</span>;
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@appointment.Status</span>;
                                        break;
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(appointment.Notes) ? "-" : appointment.Notes)</td>
                            <td>
                                @if (appointment.Status == "Scheduled" && appointment.AppointmentDate > DateTime.Now)
                                {
                                    <form asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Randevuyu iptal etmek istediğinize emin misiniz?');">
                                            İptal Et
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
