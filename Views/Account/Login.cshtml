@model GymManagementSystem.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymPro</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body class="auth-wrapper">
    <div class="row flex-grow-1 w-100 m-0">
        <div class="col-lg-5 d-none d-lg-flex flex-column auth-left justify-content-center align-items-center text-center">
            <div class="auth-split-left">
                <div class="mb-3"><i class="fa-solid fa-dumbbell fa-2x"></i></div>
                <h2 class="fw-bold display-5">“Her tekrar hedefe bir adım.”</h2>
                <p class="auth-quote">Disiplinli antrenman, güçlü zihin ve doğru rehberlik ile istediğin forma ulaş. Enerjini ortaya çıkar!</p>
                <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=700&q=80" alt="Motivasyon" class="img-fluid rounded-4 shadow mt-4">
            </div>
        </div>
        <div class="col-lg-7 d-flex align-items-center justify-content-center bg-white">
            <div class="auth-form-card glass-card p-5 w-100">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold fs-3">Gym<strong>Pro</strong></a>
                    <p class="text-muted mt-2">Tekrar hoş geldiniz. Hesabınıza giriş yapın.</p>
                </div>
                <form asp-action="Login" method="post" class="row g-4">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Email" type="email" class="form-control" placeholder="mail@example.com" aria-label="Email" />
                            <label asp-for="Email">Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••" aria-label="Şifre" />
                            <label asp-for="Password">Şifre</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe">Beni Hatırla</label>
                        </div>
                        <a asp-action="Register" class="text-orange fw-bold">Kayıt Ol</a>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-secondary w-100 py-3">Giriş Yap</button>
                    </div>
                    <div class="col-12 text-center text-muted">veya</div>
                    <div class="col-12 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-outline-secondary px-4"><i class="fa-brands fa-google me-2"></i>Google</button>
                        <button type="button" class="btn btn-outline-secondary px-4"><i class="fa-brands fa-facebook me-2"></i>Facebook</button>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
