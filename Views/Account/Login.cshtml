@model GymManagementSystem.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Gym Management System</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
        body {
            font-family: 'Lexend', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#50cec5",
                        "background-light": "#f6f8f8",
                        "background-dark": "#131f1e"
                    },
                    fontFamily: {
                        display: ["Lexend", "sans-serif"]
                    },
                    borderRadius: {
                        DEFAULT: "1rem",
                        lg: "1.25rem",
                        xl: "3rem",
                        full: "9999px"
                    }
                }
            }
        }
    </script>
</head>
<body class="font-display bg-background-light min-h-screen">
    <div class="relative flex h-screen w-full flex-col bg-background-light dark:bg-background-dark overflow-hidden">
        <div class="flex h-full w-full">
            <div class="relative hidden lg:flex w-1/2 flex-col items-center justify-center bg-gradient-to-br from-[#667eea] to-[#764ba2] p-12 text-white">
                <div class="absolute inset-0 z-0 opacity-10"
                     style="background-image:url('https://lh3.googleusercontent.com/aida-public/AB6AXuD0IW2ZqIYmEC8pM58VGStwMc_hXP0sWez2jo6UyUN6LH3k2PR1KCNdifOQf9i99P1ESaNWlrpZ0owufTxIr6b7UmcjlrZXQU8AytKh4nQLbTn29Kq0nc1CKBP14PGe7bV1aLKmkRZSS8pJFcJtn3po-pWkVixzcMTxYm1GfL12sDG7Ms9mls48phJWsK_N2hipJxK3B7ifklfrvmmCZ8v96P74d3zNE5tTESdCv1QkUb7ZJgcHrTs6QOzDbr4s2R5mOLy-iuUC0JWB');background-size:500px 500px;">
                </div>
                <div class="relative z-10 text-center px-6">
                    <h2 class="text-5xl font-bold mb-6 leading-snug">Fitness Hedeflerinize Ulaşın</h2>
                    <p class="text-xl max-w-2xl mx-auto leading-relaxed">Sağlıklı bir yaşam tarzına adım atın. Sizi motive edecek ve yönlendirecek kişisel antrenörünüz burada.</p>
                </div>
            </div>

            <div class="w-full lg:w-1/2 flex items-center justify-center p-8 xl:p-12 bg-background-light dark:bg-background-dark">
                <div class="w-full max-w-xl">
                    <div class="bg-white/80 dark:bg-black/30 backdrop-blur-2xl p-10 sm:p-14 rounded-[32px] shadow-[0_25px_60px_rgba(0,0,0,0.1)] border border-white/40 dark:border-black/30">
                        <div class="flex flex-col items-center text-center mb-10 space-y-2">
                            <h1 class="text-[#121716] dark:text-gray-100 text-[36px] font-bold leading-tight">Tekrar Hoş Geldiniz</h1>
                            <p class="text-gray-500 dark:text-gray-400 text-lg">Kişisel fitness panelinize giriş yapın.</p>
                        </div>

                        <form asp-action="Login" method="post" class="flex flex-col gap-y-7">
                            @Html.AntiForgeryToken()
                            <div>
                                <label asp-for="Email" class="text-[#121716] dark:text-gray-200 text-lg font-medium leading-normal pb-2 block">Email</label>
                                <div class="flex w-full items-stretch rounded-2xl">
                                    <div class="text-[#688280] dark:text-gray-400 flex border border-[#dde4e3] dark:border-gray-600 bg-white dark:bg-gray-700 items-center justify-center pl-5 rounded-l-2xl border-r-0">
                                        <span class="material-symbols-outlined text-2xl">mail</span>
                                    </div>
                                    <input asp-for="Email"
                                           class="form-input flex w-full min-w-0 flex-1 rounded-2xl text-[#121716] dark:text-gray-100 focus:outline-0 focus:ring-4 focus:ring-primary/40 border border-[#dde4e3] dark:border-gray-600 bg-white dark:bg-gray-700 focus:border-primary h-16 placeholder:text-[#688280] dark:placeholder:text-gray-400 px-5 rounded-l-none border-l-0 text-lg"
                                           type="email"
                                           placeholder="Email adresinizi girin" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger text-sm mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="Password" class="text-[#121716] dark:text-gray-200 text-lg font-medium leading-normal pb-2 block">Şifre</label>
                                <div class="flex w-full items-stretch rounded-2xl">
                                    <div class="text-[#688280] dark:text-gray-400 flex border border-[#dde4e3] dark:border-gray-600 bg-white dark:bg-gray-700 items-center justify-center pl-5 rounded-l-2xl border-r-0">
                                        <span class="material-symbols-outlined text-2xl">lock</span>
                                    </div>
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-input flex w-full min-w-0 flex-1 rounded-2xl text-[#121716] dark:text-gray-100 focus:outline-0 focus:ring-4 focus:ring-primary/40 border border-[#dde4e3] dark:border-gray-600 bg-white dark:bg-gray-700 focus:border-primary h-16 placeholder:text-[#688280] dark:placeholder:text-gray-400 px-5 rounded-l-none border-l-0 text-lg"
                                           placeholder="Şifrenizi girin" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger text-sm mt-1 block"></span>
                            </div>

                            <div class="flex justify-between items-center">
                                <label class="flex gap-x-3 items-center text-lg">
                                    <input asp-for="RememberMe"
                                           class="h-5 w-5 rounded border-[#dde4e3] dark:border-gray-600 border-2 bg-transparent dark:bg-gray-700 text-primary checked:bg-primary checked:border-primary focus:ring-2 focus:ring-primary/50"
                                           type="checkbox" />
                                    <span class="text-[#121716] dark:text-gray-200">Beni Hatırla</span>
                                </label>
                                <a asp-action="Register" class="font-bold text-[#4ECDC4] hover:underline text-lg">Kayıt Ol</a>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="text-danger text-sm"></div>

                            <button type="submit"
                                    class="flex w-full items-center justify-center rounded-2xl h-16 px-6 bg-gradient-to-r from-[#4ECDC4] to-[#45b6af] text-white text-xl font-bold tracking-wide shadow-[0_15px_30px_rgba(78,205,196,0.35)] hover:shadow-[0_20px_40px_rgba(78,205,196,0.45)] transition-shadow duration-300 focus:outline-none focus:ring-4 focus:ring-offset-2 focus:ring-[#4ECDC4]">
                                Giriş Yap
                            </button>
                        </form>

                        <div class="text-center mt-8">
                            <p class="text-base text-gray-600 dark:text-gray-400">
                                Hesabın yok mu?
                                <a asp-action="Register" class="font-bold text-[#4ECDC4] hover:underline">Kayıt Ol</a>
                            </p>
                        </div>
                        <div class="mt-4">
                            <partial name="_ValidationScriptsPartial" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
