@model GymManagementSystem.Models.ViewModels.AIAssistantViewModel
@{
    ViewData["Title"] = "Fitness Danışmanı";
}

@section Styles {
    <style>
        .coach-header { background: linear-gradient(135deg, #004E89 0%, #1A759F 100%); color: #fff; }
        .chat-container { height: 60vh; background: #f8f9fa; }
        .chat-card { height: 85vh; }
        .preview-img { max-height: 120px; }
    </style>
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-lg border-0 chat-card">
                <div class="card-header coach-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">Sanal Fitness Danışmanı</h5>
                        <small>Uzman sistem destekli koçluk</small>
                    </div>
                    <form asp-action="ClearHistory" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-light" type="submit">Geçmişi Temizle</button>
                    </form>
                </div>

                <div class="card-body overflow-auto chat-container" id="chatContainer">
                    @foreach (var msg in Model.ConversationHistory)
                    {
                        if (msg.Role == "user")
                        {
                            <div class="d-flex justify-content-end mb-3">
                                <div class="chat-bubble user">
                                    @msg.Content
                                    <div class="small mt-1 text-muted">@msg.CreatedAt.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-start mb-3">
                                <div class="chat-bubble bot">
                                    <strong>Koç:</strong>
                                    <div class="mt-2">@Html.Raw(msg.Content.Replace("\n", "<br>"))</div>
                                    <div class="small mt-1 text-white-50">@msg.CreatedAt.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                    <div id="loadingIndicator" class="d-none text-center my-3">
                        <div class="spinner-border text-primary" role="status" aria-label="Yükleniyor"></div>
                        <div class="mt-2 text-muted">Koç düşünüyor...</div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top">
                    <div class="collapse mb-3" id="quickInfoForm">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input type="number" id="userHeight" class="form-control" placeholder="Boy (cm)">
                            </div>
                            <div class="col-md-4">
                                <input type="number" id="userWeight" class="form-control" placeholder="Kilo (kg)">
                            </div>
                            <div class="col-md-4">
                                <select id="userBodyType" class="form-select">
                                    <option value="">Vücut Tipi</option>
                                    <option value="Ectomorph">Ectomorph</option>
                                    <option value="Mesomorph">Mesomorph</option>
                                    <option value="Endomorph">Endomorph</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="imagePreview" class="d-none mb-2">
                        <div class="position-relative d-inline-block">
                            <img id="previewImg" src="" class="rounded preview-img">
                            <button class="btn btn-sm btn-danger position-absolute top-0 end-0" type="button" onclick="removeImage()">Sil</button>
                        </div>
                    </div>

                    <div class="input-group">
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#quickInfoForm">Hızlı Bilgilerim</button>
                        <input type="file" id="imageInput" accept="image/*" class="d-none" onchange="handleImageUpload(event)">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('imageInput').click()">Fotoğraf</button>
                        <textarea id="messageInput" class="form-control" placeholder="Mesajını yaz..." rows="1" onkeypress="handleKeyPress(event)"></textarea>
                        <button class="btn btn-primary" type="button" onclick="sendMessage()">Gönder</button>
                    </div>

                    <div class="mt-2 d-flex gap-2 flex-wrap">
                        <button class="quick-prompt" type="button" onclick="quickPrompt('Vücudumu güçlendirmek için nasıl bir program izlemeliyim?')">Güç Programı</button>
                        <button class="quick-prompt" type="button" onclick="quickPrompt('Kas kütlesi için beslenme önerisi hazırla')">Beslenme</button>
                        <button class="quick-prompt" type="button" onclick="quickPrompt('Bu hafta için kombin egzersiz planı öner')">Haftalık Plan</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentImageBase64 = null;

    function handleKeyPress(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    }

    function handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                currentImageBase64 = e.target.result.split(',')[1];
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('imagePreview').classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }

    function removeImage() {
        currentImageBase64 = null;
        document.getElementById('imagePreview').classList.add('d-none');
        document.getElementById('imageInput').value = '';
    }

    function quickPrompt(message) {
        document.getElementById('messageInput').value = message;
        sendMessage();
    }

    async function sendMessage() {
        const messageInput = document.getElementById('messageInput');
        const message = messageInput.value.trim();
        if (!message && !currentImageBase64) return;

        const data = {
            message: message || "Bu fotoğrafı analiz eder misin?",
            imageBase64: currentImageBase64,
            height: document.getElementById('userHeight').value,
            weight: document.getElementById('userWeight').value,
            bodyType: document.getElementById('userBodyType').value
        };

        addMessageToChat('user', data.message);
        messageInput.value = '';
        removeImage();
        toggleLoading(true);

        try {
            const response = await fetch('@Url.Action("SendMessage", "AIAssistant")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            toggleLoading(false);

            if (result.success) {
                addMessageToChat('assistant', result.response);
            } else {
                addMessageToChat('assistant', 'Hata: ' + result.error);
            }
        } catch (error) {
            toggleLoading(false);
            addMessageToChat('assistant', 'Bağlantı hatası: ' + error.message);
        }
    }

    function addMessageToChat(role, content) {
        const container = document.getElementById('chatContainer');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const messageDiv = document.createElement('div');

        if (role === 'user') {
            messageDiv.className = 'd-flex justify-content-end mb-3';
            messageDiv.innerHTML = `
                <div class="chat-bubble user">
                    ${content}
                    <div class="small mt-1 text-muted">${new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}</div>
                </div>`;
        } else {
            messageDiv.className = 'd-flex justify-content-start mb-3';
            messageDiv.innerHTML = `
                <div class="chat-bubble bot">
                    <strong>Koç:</strong>
                    <div class="mt-2">${content.replace(/\n/g, '<br>')}</div>
                    <div class="small mt-1 text-white-50">${new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}</div>
                </div>`;
        }

        container.insertBefore(messageDiv, loadingIndicator);
        scrollToBottom();
    }

    function toggleLoading(show) {
        const loadingIndicator = document.getElementById('loadingIndicator');
        loadingIndicator.classList.toggle('d-none', !show);
        scrollToBottom();
    }

    function scrollToBottom() {
        const container = document.getElementById('chatContainer');
        container.scrollTop = container.scrollHeight;
    }

    window.addEventListener('load', scrollToBottom);
</script>
