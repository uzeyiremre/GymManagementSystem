@model GymManagementSystem.Models.ViewModels.HomeLandingViewModel
@{
    ViewData["Title"] = "GymPro - Modern Fitness";
    Layout = "_Layout";
    ViewData["FullWidthLayout"] = true;
    var totalMembers = Model?.TotalMembers ?? 0;
    var activeTrainers = Model?.ActiveTrainers ?? 0;
    var completedAppointments = Model?.CompletedAppointments ?? 0;
}

<section class="hero-section">
    <div class="container-fluid px-0">
        <div class="container-xxl px-4">
            <div class="row align-items-center min-vh-100 g-5 justify-content-between">
                <div class="col-xl-6 col-lg-7 hero-content" data-aos="fade-right">
                    <div class="hero-badge mb-3"><i class="fa-solid fa-bolt"></i> Enerjik Fitness Deneyimi</div>
                    <h1 class="hero-title text-white mb-4">GymPro'ya Hoş<br><span class="text-gradient">Geldiniz!</span></h1>
                    <p class="hero-subtitle text-white mb-5">Güçlü antrenman programları, profesyonel antrenörler ve dinamik toplulukla hedeflerinize ulaş. Enerjini ortaya çıkar!</p>
                    <div class="d-flex flex-wrap gap-3 mb-4 hero-cta">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary gradient-yellow text-dark">Ücretsiz Dene</a>
                        <a href="#neden" class="btn btn-outline-light">Keşfet</a>
                    </div>
                    <div class="d-flex gap-4 flex-wrap mb-4">
                        <div class="stat-badge bg-white bg-opacity-25 rounded-pill px-4 py-3">
                            <i class="fas fa-users text-white me-2"></i>
                            <span class="fw-bold text-white fs-4">@totalMembers.ToString("N0") Üye</span>
                        </div>
                        <div class="stat-badge bg-white bg-opacity-25 rounded-pill px-4 py-3">
                            <i class="fas fa-dumbbell text-white me-2"></i>
                            <span class="fw-bold text-white fs-4">@activeTrainers.ToString("N0") Antrenör</span>
                        </div>
                        <div class="stat-badge bg-white bg-opacity-25 rounded-pill px-4 py-3">
                            <i class="fas fa-check-circle text-white me-2"></i>
                            <span class="fw-bold text-white fs-4">@completedAppointments.ToString("N0") Seans</span>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5 col-lg-5 text-center" data-aos="fade-left">
                    <img src="https://images.unsplash.com/photo-1579758629938-03607ccdbaba?auto=format&fit=crop&w=900&q=80" alt="Atletik silüet" class="hero-illustration img-fluid rounded-4">
                </div>
            </div>
        </div>
    </div>
</section>

<section id="neden" class="section-spacing features-section">
    <div class="container-fluid px-0">
        <div class="container-xxl">
            <div class="text-center mb-5" data-aos="fade-up">
                <h2 class="fw-bold display-6">Neden GymPro?</h2>
                <p class="text-muted lead">Uzman koçluk, enerji dolu programlar ve destekleyici toplulukla yeni seviyene yüksel.</p>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="50">
                    <div class="feature-card card border-0 shadow-lg h-100">
                        <div class="feature-icon mx-auto mb-4"><i class="fa-solid fa-dumbbell"></i></div>
                        <h4 class="fw-bold mb-3">Güçlü Programlar</h4>
                        <p class="text-muted mb-0">Performans odaklı, bilimsel olarak planlanmış antrenmanlarla hedefine kilitlen.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-card card border-0 shadow-lg h-100">
                        <div class="feature-icon mx-auto mb-4"><i class="fa-solid fa-calendar-check"></i></div>
                        <h4 class="fw-bold mb-3">Kolay Randevu</h4>
                        <p class="text-muted mb-0">Programını seç, antrenörünü ayarla ve birkaç tıkla seansını oluştur.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="150">
                    <div class="feature-card card border-0 shadow-lg h-100">
                        <div class="feature-icon mx-auto mb-4"><i class="fa-solid fa-chart-line"></i></div>
                        <h4 class="fw-bold mb-3">İlerleme Takibi</h4>
                        <p class="text-muted mb-0">Vücut ölçüleri, performans grafikleri ve raporlarla gelişimini izle.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-card card border-0 shadow-lg h-100">
                        <div class="feature-icon mx-auto mb-4"><i class="fa-solid fa-users-gear"></i></div>
                        <h4 class="fw-bold mb-3">Topluluk & Koçluk</h4>
                        <p class="text-muted mb-0">Motivasyon dolu topluluk ve alanında uzman koçlarla yan yana çalış.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stats-section py-5 bg-dark-navy">
    <div class="container-fluid px-0">
        <div class="container-xxl">
            <div class="row g-5 text-center">
                <div class="col-lg-3 col-6" data-aos="zoom-in">
                    <div class="stat-box p-4">
                        <h2 class="stat-number text-warning mb-3">@totalMembers.ToString("N0")</h2>
                        <p class="stat-label text-white-50 mb-0">TOPLAM ÜYE</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6" data-aos="zoom-in" data-aos-delay="80">
                    <div class="stat-box p-4">
                        <h2 class="stat-number text-info mb-3">@activeTrainers.ToString("N0")</h2>
                        <p class="stat-label text-white-50 mb-0">AKTİF ANTRENÖR</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6" data-aos="zoom-in" data-aos-delay="140">
                    <div class="stat-box p-4">
                        <h2 class="stat-number text-primary mb-3">@completedAppointments.ToString("N0")</h2>
                        <p class="stat-label text-white-50 mb-0">TAMAMLANAN SEANS</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6" data-aos="zoom-in" data-aos-delay="200">
                    <div class="stat-box p-4">
                        <h2 class="stat-number text-warning mb-3">4.9</h2>
                        <p class="stat-label text-white-50 mb-0">MEMNUNİYET</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-spacing" id="paketler">
    <div class="container-fluid px-0">
        <div class="container-xxl">
            <div class="cta-banner" data-aos="fade-up">
                <div>
                    <div class="text-uppercase fw-bold text-dark mb-2">GymPro Challenge</div>
                    <div class="cta-title mb-2">Hazır mısın?</div>
                    <p class="mb-3">Enerjik ortam, uzman koçluk ve kişiye özel planlarla bugünden başla. Hedefine giden ilk adımı şimdi at.</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Şimdi Başla</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-secondary">Üye Girişi</a>
                    </div>
                </div>
                <div class="text-center">
                    <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=520&q=80" alt="Fitness ekipman" class="img-fluid rounded-4 shadow-soft">
                </div>
            </div>
        </div>
    </div>
</section>
